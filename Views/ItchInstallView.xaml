<UserControl x:Class="ItchioDownloader.Views.ItchInstallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d1p1:Ignorable="d"
             xmlns:d1p1="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignWidth="640" d:DesignHeight="520"
             Width="640">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <!-- Playnite themes expose the base text style as a keyed resource, not an
             implicit TextBlock style, so bare TextBlocks in a CreateWindow fall back to
             the WPF default font/colour. Rebasing the implicit style fixes the theme. -->
        <Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource BaseTextBlockStyle}" />
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="{Binding GameTitle}" FontSize="20" FontWeight="Bold"
                   TextTrimming="CharacterEllipsis" />

        <DockPanel Grid.Row="1" Margin="0,16,0,6">
            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center"
                      Content="Mostrar incompatíveis"
                      IsChecked="{Binding ShowIncompatible}"
                      Visibility="{Binding HasIncompatible, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="Arquivo" FontWeight="Bold" VerticalAlignment="Center" />
        </DockPanel>

        <ListBox Grid.Row="2" MinHeight="140" MaxHeight="260"
                 ItemsSource="{Binding Uploads}"
                 SelectedItem="{Binding SelectedUpload}"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="2,4">
                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="Instalar em" FontWeight="Bold" />
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Right" Content="…" Padding="16,4" Margin="8,0,0,0"
                        Command="{Binding BrowseCommand}" />
                <ComboBox ItemsSource="{Binding Locations}"
                          SelectedItem="{Binding SelectedLocation}"
                          DisplayMemberPath="Path" />
            </DockPanel>
        </StackPanel>

        <Grid Grid.Row="4" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Download" Margin="0,0,16,4" Opacity="0.7" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DownloadSizeText}" Margin="0,0,0,4" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Em disco" Margin="0,0,16,4" Opacity="0.7" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InstallSizeText}" Margin="0,0,0,4" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Espaço livre" Margin="0,0,16,4" Opacity="0.7" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FreeSpaceText}" Margin="0,0,0,4" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Depois de instalar" Margin="0,0,16,0" Opacity="0.7" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding AfterInstallText}" />
        </Grid>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Instalar" Padding="24,6" IsDefault="True"
                    Command="{Binding InstallCommand}" />
            <Button Content="Cancelar" Padding="24,6" Margin="8,0,0,0" IsCancel="True"
                    Command="{Binding CancelCommand}" />
        </StackPanel>
    </Grid>
</UserControl>
