<UserControl x:Class="ItchioDownloader.Views.ItchioDownloaderSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             d1p1:Ignorable="d"
             xmlns:d1p1="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DesignWidth="600">
    <StackPanel Margin="20">

        <TextBlock Text="itch.io account" FontSize="16" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Generate a key at itch.io/user/settings/api-keys and paste it below. The key is exchanged for credentials that butler stores in this extension's own database." />

        <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Connect" Margin="8,0,0,0" Padding="16,4"
                    Command="{Binding ConnectCommand}" />
            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" />
        </DockPanel>

        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="Disconnect" Margin="8,0,0,0" Padding="16,4"
                    Command="{Binding DisconnectCommand}" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center" />
        </DockPanel>

        <Separator Margin="0,20,0,12" />

        <TextBlock Text="Installation" FontSize="16" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Folder where new games are installed. Empty uses the extension's data folder." />
        <DockPanel Margin="0,8,0,0">
            <Button DockPanel.Dock="Right" Content="…" Margin="8,0,0,0" Padding="16,4"
                    Command="{Binding BrowseInstallLocationCommand}" />
            <TextBox Text="{Binding Settings.InstallLocationPath}" />
        </DockPanel>

        <CheckBox Margin="0,12,0,0" IsChecked="{Binding Settings.AdoptItchAppInstalls}"
                  Content="Adopt games already installed by the itch.io app" />
        <TextBlock TextWrapping="Wrap" Margin="24,4,0,0" Opacity="0.7"
                   Text="Registers the itch app folder as an install location and rebuilds the records from the receipts on disk." />
        <Button Margin="24,8,0,0" Padding="16,4" HorizontalAlignment="Left"
                Content="Adopt now" Command="{Binding AdoptCommand}" />

        <Separator Margin="0,20,0,12" />

        <TextBlock Text="Migration" FontSize="16" FontWeight="Bold" />
        <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Moves library entries between Playnite's built-in itch.io plugin and this one. Play time, tags, covers and status are preserved — only the source changes." />
        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
            <Button Padding="16,4" Content="Migrate from original plugin" Command="{Binding MigrateCommand}" />
            <Button Padding="16,4" Margin="8,0,0,0" Content="Revert" Command="{Binding RevertMigrationCommand}" />
        </StackPanel>

        <Separator Margin="0,20,0,12" />

        <TextBlock Text="Import" FontSize="16" FontWeight="Bold" />
        <CheckBox Margin="0,12,0,0" IsChecked="{Binding Settings.ImportOwnedGames}"
                  Content="Import purchased / claimed games" />
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding Settings.ImportInstalledGames}"
                  Content="Import installed games" />
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding Settings.OnlyGameClassification}"
                  Content="Only items classified as games (ignore tools, comics, soundtracks, assets)" />
        <CheckBox Margin="0,8,0,0" IsChecked="{Binding Settings.OnlyWindowsCompatible}"
                  Content="Only items marked as Windows-compatible" />
        <TextBlock TextWrapping="Wrap" Margin="24,4,0,0" Opacity="0.7"
                   Text="Warning: many itch.io uploads have no platform tagging and would be discarded." />

    </StackPanel>
</UserControl>
